# Where inquiries from the contact and solution forms are POSTed as JSON (CRM, Zapier/Make, form service…).
# Required in production: without it the form tells visitors their request was not sent and shows the email address.
QUOTE_WEBHOOK_URL=

# Public origin of this site, used for canonical URLs, the sitemap and structured data.
# On Vercel it falls back to the production URL, so set it when a custom domain is added.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi CMS base URL (no trailing slash). Optional: used only for product photographs.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
