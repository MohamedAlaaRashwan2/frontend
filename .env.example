# Strapi CMS base URL (no trailing slash)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Where quote requests from /contact are POSTed as JSON (CRM, Zapier/Make, Slack, form service…).
# Required in production — without it the form shows an "email us instead" message.
QUOTE_WEBHOOK_URL=

# Public URL of this site, used for social-share image links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
